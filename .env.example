# ConnectQR app settings.
# Copy to .env for local development, or set these as EAS environment variables.

# Base URL of the ConnectQR backend, without a trailing /api.
# Android emulator reaches the host machine at 10.0.2.2.
# A physical device on the same Wi-Fi needs your machine's LAN address.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Public base URL used when building shareable profile links.
EXPO_PUBLIC_WEB_BASE=https://connectqr.app

# Optional. When set, a development build that registers a reporter will send
# crash reports there. See services/errorReporting.ts.
EXPO_PUBLIC_SENTRY_DSN=
