# Server
PORT=3000
NODE_ENV=development

# Auth
# In production this MUST be a unique value of at least 32 characters.
# The app refuses to start in production if it is left at the dev default.
JWT_SECRET=connectqr-dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed origins. "*" is refused in production.
CORS_ORIGIN=http://localhost:8081

# Database
DATABASE_URL=postgres://connectqr:connectqr@localhost:5432/connectqr
DB_HOST=localhost
DB_PORT=5432
DB_USER=connectqr
DB_PASSWORD=connectqr
DB_NAME=connectqr

# Schema management. Use migrations in every real environment.
# DB_SYNCHRONIZE=true is ignored when NODE_ENV=production.
DB_SYNCHRONIZE=false
DB_RUN_MIGRATIONS=true

# Offline payload signing (optional).
# PEM-encoded Ed25519 private key, used to sign offline QR payloads server-side
# while online. Leave blank to return unsigned payloads and let the device sign
# with its own registered key (POST /api/keys) - that path needs no internet.
# Generate a key pair with:
#   node -e "const c=require('crypto');const{privateKey}=c.generateKeyPairSync('ed25519');console.log(privateKey.export({format:'pem',type:'pkcs8'}).toString())"
OFFLINE_SIGNING_PRIVATE_KEY=

# Email (optional). Leave MAIL_HOST blank to use sandbox mode, where password
# reset and verification emails are written to the server log instead of sent.
# Set MAIL_HOST (and optionally the rest) to deliver real email via SMTP.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=
# MAIL_PASS=
# MAIL_FROM=ConnectQR <no-reply@example.com>

# Public base URL of this API. Used to build the links inside reset and
# verification emails, so set it to your real host in production.
APP_BASE_URL=http://localhost:3000
